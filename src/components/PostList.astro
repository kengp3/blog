---
import { href } from '../lib/posts';
const { entries } = Astro.props;
---

<div class="post-list">
  {
    entries.map((post) => (
      <article class="post-row">
        <time datetime={post.data.date}>{post.data.date.replaceAll('-', '.')}</time>
        <div>
          <div class="post-tags">
            {post.data.tags.map((tag) => (
              <a href={href(`/tag/${tag}/`)}>{tag}</a>
            ))}
          </div>
          <>
            <h2>
              <a href={href(post.data.permalink)}>{post.data.title}</a>
            </h2>
            <p>{post.data.description}</p>
          </>
        </div>
        <a
          class="read-arrow"
          href={href(post.data.permalink)}
          aria-label={`閱讀：${post.data.title}`}
        >
          ↗
        </a>
      </article>
    ))
  }
</div>
