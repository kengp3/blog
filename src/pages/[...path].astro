---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { posts, href, comments } from '../lib/posts';
export async function getStaticPaths() {
  return (await posts()).map((post) => ({
    params: { path: post.data.permalink.slice(1, -1) },
    props: { post },
  }));
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
---

<Base title={post.data.title} description={post.data.description} article>
  <article>
    <header class="article-heading">
      <a class="text-link" href={href()}>返回 Blog</a><nav class="post-tags" aria-label="文章標籤">
        {post.data.tags.map((tag) => <a href={href(`/tag/${tag}/`)}>{tag}</a>)}
      </nav><h1>{post.data.title}</h1><p class="byline">
        <time datetime={post.data.date}>{post.data.date.replaceAll('-', '.')}</time><span
          >{post.data.author} in {post.data.location}</span>
      </p>
    </header>
    <div class="reading-layout">
      {
        headings.length > 0 && (
          <aside class="toc">
            <nav aria-label="文章目錄">
              <h2>本文內容</h2>
              {headings
                .filter((h) => h.depth < 4)
                .map((h) => (
                  <a class:list={{ subheading: h.depth === 3 }} href={`#${h.slug}`}>
                    {h.text}
                  </a>
                ))}
            </nav>
          </aside>
        )
      }
      <div class="article-body">
        <div class="prose"><Content /></div><section
          class="comments"
          aria-labelledby="comments-title"
        >
          <h2 id="comments-title">接著聊聊</h2><p>有想法或問題？歡迎到 GitHub 留言。</p><a
            class="text-link"
            href={comments(post.data)}
            >{post.data.issue ? '查看／回覆 GitHub 留言' : '在 GitHub 建立留言'}
            <span aria-hidden="true">↗</span></a>
        </section><a class="text-link back-link" href={href()}>返回所有文章</a>
      </div>
    </div>
  </article>
</Base>
