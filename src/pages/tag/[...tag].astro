---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { posts, href } from '../../lib/posts';
export async function getStaticPaths() {
  const entries = await posts();
  const tags = [...new Set(entries.flatMap((post) => post.data.tags))].sort();
  return [undefined, ...tags].map((tag) => ({
    params: { tag },
    props: {
      tag,
      tags,
      entries: tag ? entries.filter((post) => post.data.tags.includes(tag)) : entries,
    },
  }));
}
const { tag, tags, entries } = Astro.props;
---

<Base title={tag ? `${tag} | Tags` : 'Tags'}>
  <section class="page-heading">
    <a class="text-link" href={href()}>Blog</a><h1>{tag ?? 'Tags'}</h1><p>
      {tag ? `${entries.length} 篇相關文章` : '沿著一個主題，慢慢讀。'}
    </p>
  </section>
  <nav class="tag-nav" aria-label="篩選主題">
    <a href={href('/tag/')} aria-current={!tag ? 'page' : undefined}>全部</a>{
      tags.map((item) => (
        <a href={href(`/tag/${item}/`)} aria-current={tag === item ? 'page' : undefined}>
          {item}
        </a>
      ))
    }
  </nav>
  <PostList entries={entries} />
</Base>
